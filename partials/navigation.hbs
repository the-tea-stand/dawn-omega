<div class="my-fancy-nav-wrapper">
    <ul class="nav">
        {{!-- Regular nav items, everything except the ones grouped into the dropdown below --}}
        {{#unless isSecondary}}
        {{!-- Top nav bar (above the hamburger breakpoint): collapse Introduction/FAQ/Resources into a dropdown --}}
        <li class="nav-dropdown nav-dropdown-desktop">
            <details>
                <summary class="nav-dropdown-toggle">About</summary>
                <div class="nav-dropdown-menu">
                    {{#foreach navigation}}
                    {{#match slug "=" "introduction"}}
                    <a class="nav-{{slug}}{{#if current}} nav-current{{/if}}"
                        href='{{url absolute="true"}}'>{{label}}</a>
                    {{else match slug "=" "faq"}}
                    <a class="nav-{{slug}}{{#if current}} nav-current{{/if}}"
                        href='{{url absolute="true"}}'>{{label}}</a>
                    {{else match slug "=" "resources"}}
                    <a class="nav-{{slug}}{{#if current}} nav-current{{/if}}"
                        href='{{url absolute="true"}}'>{{label}}</a>
                    {{/match}}
                    {{/foreach}}
                </div>
            </details>
        </li>
        {{!-- Hamburger menu (below the breakpoint): render Introduction/FAQ/Resources as plain links --}}
        {{#foreach navigation}}
        {{#match slug "=" "introduction"}}
        <li class="nav-{{slug}}{{#if current}} nav-current{{/if}} nav-dropdown-mobile"><a href='{{url absolute="true"}}'>{{label}}</a></li>
        {{else match slug "=" "faq"}}
        <li class="nav-{{slug}}{{#if current}} nav-current{{/if}} nav-dropdown-mobile"><a href='{{url absolute="true"}}'>{{label}}</a></li>
        {{else match slug "=" "resources"}}
        <li class="nav-{{slug}}{{#if current}} nav-current{{/if}} nav-dropdown-mobile"><a href='{{url absolute="true"}}'>{{label}}</a></li>
        {{/match}}
        {{/foreach}}
        {{/unless}}
        {{#foreach navigation}}
        {{#match slug "=" "introduction"}}
        {{else match slug "=" "faq"}}
        {{else match slug "=" "resources"}}
        {{else}}
        <li class="nav-{{slug}}{{#if current}} nav-current{{/if}}"><a href='{{url absolute="true"}}'>{{label}}</a></li>
        {{/match}}
        {{/foreach}}
    </ul>
</div>
